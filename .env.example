# Select one provider: anthropic, groq, gemini, openai, or github.
# Anthropic is the default and recommended provider.
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic. Create a key at:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional; only needed when LLM_PROVIDER=groq. Create a key at:
# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional; only needed when LLM_PROVIDER=gemini. Create a key at:
# https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key

# Optional; only needed when LLM_PROVIDER=openai. Create a key at:
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Optional; only needed when LLM_PROVIDER=github. Create a token at:
# https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token

# Pinned Claude snapshot for stable behavior and cost; update deliberately.
# Other options for more reasoning power: claude-sonnet-5 (higher cost) or
# claude-opus-5 (highest cost; reserve for complex edge cases).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# If this ID returns not_found_error, check the current model list:
# https://docs.claude.com/en/docs/about-claude/models

# Only used when LLM_PROVIDER=groq.
# Other options: openai/gpt-oss-120b, llama-3.1-8b-instant, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-20b
# Groq can retire model IDs; for a 404 model_not_found, check:
# https://console.groq.com/docs/models
# The gpt-oss models are reasoning models; configure Groq calls to hide
# reasoning output before downstream JSON parsing.

# Only used when LLM_PROVIDER=openai.
OPENAI_MODEL=gpt-4o-mini

# Only used when LLM_PROVIDER=github.
GITHUB_MODEL=openai/gpt-4.1-mini
